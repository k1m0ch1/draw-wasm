# Rendered at deploy time: @@HOST@@ is replaced by the real host name.
# No global `map $http_upgrade` is defined here (it may already exist); the Connection header is set inline.
limit_req_zone $binary_remote_addr zone=draw_api:10m rate=20r/s;

# Port 80: ACME challenges, a redirect to HTTPS for plain requests, and the app itself for requests a
# CDN in "flexible" mode forwards (marked https via CF-Visitor), where a blanket redirect would loop.
# /coret-api/ and /coret-ws/ are origin endpoints for the coret.app edge (a Cloudflare Worker proxies to them).
server {
    listen 80;
    listen [::]:80;
    server_name @@HOST@@;

    include snippets/cloudflare-realip.conf;

    location /.well-known/acme-challenge/ { root /var/www/html; }

    location /coret-api/ {
        limit_req zone=draw_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8191/api/;
        proxy_http_version 1.1;
        proxy_set_header Host coret.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location /coret-ws/ {
        proxy_pass http://127.0.0.1:8191/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host coret.app;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    client_max_body_size 5m;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types application/javascript text/javascript text/css application/json application/wasm image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;

    location /ws/ {
        set $draw_redirect 1;
        if ($http_cf_visitor ~ '"scheme":"https"') { set $draw_redirect 0; }
        if ($draw_redirect) { return 301 https://$host$request_uri; }
        proxy_pass http://127.0.0.1:8190;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /api/ {
        set $draw_redirect 1;
        if ($http_cf_visitor ~ '"scheme":"https"') { set $draw_redirect 0; }
        if ($draw_redirect) { return 301 https://$host$request_uri; }
        limit_req zone=draw_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8190;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    location / {
        set $draw_redirect 1;
        if ($http_cf_visitor ~ '"scheme":"https"') { set $draw_redirect 0; }
        if ($draw_redirect) { return 301 https://$host$request_uri; }
        proxy_pass http://127.0.0.1:8190;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @@HOST@@;

